<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BrightSpring.Referral.Api</RootNamespace>
    <UserSecretsId>bf3a9b1e-6a9d-4b7d-9b0e-b6f9c9f6b8a1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      AddOpenApi()/MapOpenApi() (used in Program.cs) come from this
      package, not from Microsoft.NET.Sdk.Web itself — the Web SDK gives
      you minimal APIs and Kestrel, but OpenAPI document generation is
      opt-in via this separate reference.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />

    <!--
      Pinned explicitly, not left to float: Microsoft.AspNetCore.OpenApi
      10.0.x is compiled against Microsoft.OpenApi 2.x's concrete types
      (OpenApiMediaType, etc.). Microsoft.OpenApi 3.x reworked the same
      surface into read-only interfaces (IOpenApiMediaType), which breaks
      AddOpenApi's generated XML-comment support: the generated code
      tries to assign IOpenApiMediaType.Example, which is now a read-only
      property, producing a CS0200 compile error. That is exactly the
      error you hit after accepting a NuGet "update available" prompt
      that floated this package to 3.x. The two packages don't line up
      again until .NET 11, so until then this stays pinned to a 2.x
      version regardless of what NuGet later suggests.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.3.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrightSpring.Referral.Core\BrightSpring.Referral.Core.csproj" />
    <ProjectReference Include="..\BrightSpring.Referral.Rules\BrightSpring.Referral.Rules.csproj" />
    <ProjectReference Include="..\BrightSpring.Referral.Agents\BrightSpring.Referral.Agents.csproj" />
  </ItemGroup>

</Project>
